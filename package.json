{
  "name": "contentflow-lite",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter contentflow-lite-client dev",
    "build": "pnpm --filter contentflow-lite-client build",
    "preview": "pnpm --filter contentflow-lite-client preview",
    "server:dev": "pnpm --filter contentflow-lite-server dev",
    "server:build": "pnpm --filter contentflow-lite-server build",
    "phase:check": "bash scripts/phase-gate.sh check",
    "phase:advance": "bash scripts/phase-gate.sh advance",
    "phase:status": "bash scripts/phase-gate.sh status",
    "postinstall": "bash -c '[ -d .git ] && ln -sf ../../scripts/pre-commit-hook.sh .git/hooks/pre-commit 2>/dev/null; ln -sf ../../scripts/pre-push-hook.sh .git/hooks/pre-push 2>/dev/null || true'"
  }
}
